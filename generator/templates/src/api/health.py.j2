"""
Health Check API endpoints
"""
from fastapi import APIRouter, Request
from fastapi.responses import JSONResponse
from typing import Dict
from datetime import datetime, timezone

router = APIRouter()


@router.get("")
@router.get("/")
async def health_check(request: Request) -> Dict:
    """
    Complete health check of service and all components.
    Returns 200 if all components are healthy, 503 if there are issues.
    """
    health_checker = request.app.state.health_checker
    report = await health_checker.check_all()
    
    if report["status"] == "unhealthy":
        return JSONResponse(status_code=503, content=report)
    
    return report


@router.get("/live")
async def liveness_check() -> Dict:
    """
    Liveness probe (Kubernetes).
    Does not check external dependencies.
    """
    return {
        "status": "alive",
        "timestamp": datetime.now(timezone.utc).isoformat()
    }


@router.get("/ready")
async def readiness_check(request: Request) -> Dict:
    """
    Readiness probe (Kubernetes).
    Checks all external dependencies.
    """
    health_checker = request.app.state.health_checker
    report = await health_checker.check_all()
    
    if report["status"] == "unhealthy":
        return JSONResponse(status_code=503, content=report)
    
    return report