"""
LangFuse configuration and OpenTelemetry setup
"""
import logging
from src.config import get_settings

logger = logging.getLogger(__name__)
settings = get_settings()


def setup_langfuse():
    """Initialize LangFuse with OpenTelemetry"""
    if not settings.langfuse_enabled:
        logger.info("LangFuse is disabled")
        return
    
    try:
        import langfuse
        from opentelemetry import trace
        from opentelemetry.sdk.trace import TracerProvider
        from opentelemetry.sdk.trace.export import BatchSpanProcessor
        from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
        from opentelemetry.instrumentation.fastapi import FastAPIInstrumentor
        
        # Configure LangFuse
        langfuse_client = langfuse.Langfuse(
            public_key=settings.langfuse_public_key,
            secret_key=settings.langfuse_secret_key,
            host=settings.langfuse_host
        )
        
        # Setup OpenTelemetry
        trace.set_tracer_provider(TracerProvider())
        
        # Configure OTLP exporter for LangFuse
        otlp_exporter = OTLPSpanExporter(
            endpoint=f"{settings.langfuse_host}/api/public/otel/v1/traces",
            headers={
                "Authorization": f"Bearer {settings.langfuse_public_key}:{settings.langfuse_secret_key}"
            }
        )
        
        trace.get_tracer_provider().add_span_processor(
            BatchSpanProcessor(otlp_exporter)
        )
        
        logger.info(f"LangFuse initialized with host: {settings.langfuse_host}")
        
        return langfuse_client
        
    except ImportError as e:
        logger.error(f"Failed to import LangFuse dependencies: {e}")
        logger.info("Install required packages: pip install langfuse opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp")
    except Exception as e:
        logger.error(f"Failed to initialize LangFuse: {e}")


def get_langfuse_callback():
    """Get LangFuse callback handler for LangChain"""
    try:
        from langfuse.callback import CallbackHandler
        
        return CallbackHandler(
            public_key=settings.langfuse_public_key,
            secret_key=settings.langfuse_secret_key,
            host=settings.langfuse_host
        )
    except ImportError:
        logger.warning("LangFuse callback handler not available")
        return None