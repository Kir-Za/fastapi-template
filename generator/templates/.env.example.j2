# {{ service_name }} Environment Configuration
# 12-factor app: all configuration through environment variables

# Application
APP_NAME={{ service_name }}
APP_VERSION=0.1.0
APP_DESCRIPTION="FastAPI Microservice with LangChain"
DEBUG=false

# Server
HOST=0.0.0.0
PORT={{ port }}
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

{% if features.redis %}
# Redis Configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
{% endif %}

{% if features.rabbitmq %}
# RabbitMQ Configuration
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/{{ rabbitmq_vhost }}
RABBITMQ_QUEUE_PREFIX={{ service_name }}
{% endif %}

{% if features.langfuse %}
# LangFuse Configuration
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY={{ langfuse_public_key }}
LANGFUSE_SECRET_KEY={{ langfuse_secret_key }}
LANGFUSE_HOST={{ langfuse_host }}
{% endif %}